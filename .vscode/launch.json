{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "SGS BARBEARIA - SUPABASE",
      "request": "launch",
      "mainClass": "com.sgsbarber.SgsbarberApplication",
      "projectName": "sgsbarber",
      "env": {
        "SUPABASE_DB_PASSWORD": "${input:supabaseDbPassword}"
      }
    },
    {
      "type": "pwa-chrome",
      "name": "SGS Barber - Frontend",
      "request": "launch",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "inputs": [
    {
      "id": "supabaseDbPassword",
      "type": "promptString",
      "description": "Senha do banco PostgreSQL do Supabase",
      "password": true
    }
  ]
}
